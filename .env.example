# WasaTN — WhatsApp automation SaaS
#
# Copy to .env and fill in real values. Never commit .env.

# --- Runtime -------------------------------------------------------------
# development | production | test
SUPERKIT_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Set to true only when running behind a proxy you control (Fly, Railway, nginx).
# When false, X-Forwarded-For is ignored so clients cannot spoof their IP.
TRUST_PROXY=false

# --- Database (Neon or any Postgres 13+) ---------------------------------
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Secrets -------------------------------------------------------------
# At least 32 bytes. Generate: openssl rand -base64 48
SESSION_SECRET=

# Exactly 32 bytes, base64 or 64-char hex. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

SESSION_COOKIE_NAME=wasatn_session

# --- Meta / WhatsApp Cloud API -------------------------------------------
# From the Meta App Dashboard > App settings > Basic.
META_APP_ID=
META_APP_SECRET=
# Arbitrary string you choose; Meta echoes it back during webhook verification.
META_VERIFY_TOKEN=
# Cloud API version segment. v25.0 is what Embedded Signup v4 expects; a missing
# "v" is corrected automatically.
META_GRAPH_VERSION=v25.0

# Shared secret for external cron pings. Required in production.
CRON_SECRET=

# --- Job queue (River, Postgres-backed) ----------------------------------
RIVER_MAX_WORKERS=50
# Messages per second across all workers. Per-WABA limits are applied on top.
RIVER_CONCURRENCY_LIMIT=50

# --- Development ---------------------------------------------------------
# Override the migrations path when running the migrate command outside the repo root.
# MIGRATIONS_DIR=
